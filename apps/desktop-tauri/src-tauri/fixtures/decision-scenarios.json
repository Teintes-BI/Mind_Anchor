    {
      "id": "quiet-hours-across-midnight",
      "description": "静默时段跨越午夜（22:00–08:00）。23 点与 3 点必须静默，8 点是排他边界应恢复。",
      "policy": {
        "max_idle_seconds": 30,
        "away_idle_seconds": 900,
        "min_focus_ms": 300000,
        "max_switches_in_window": 8,
        "switch_window_ms": 600000,
        "quiet_hour_start": 22,
        "quiet_hour_end": 8,
        "daily_budget": 3
      },
      "steps": [
        {
          "at_ms": 0,
          "app": "Code",
          "idle_seconds": 60,
          "local_hour": 22,
          "expect": {
            "decision": "silence",
            "reasons": ["outside_quiet_hours"]
          }
        },
        {
          "at_ms": 3600000,
          "app": "Code",
          "idle_seconds": 60,
          "local_hour": 23,
          "expect": {
            "decision": "silence",
            "reasons": ["outside_quiet_hours"]
          }
        },
        {
          "at_ms": 7200000,
          "app": "Code",
          "idle_seconds": 60,
          "local_hour": 0,
          "expect": {
            "decision": "silence",
            "reasons": ["outside_quiet_hours"]
          }
        },
        {
          "at_ms": 10800000,
          "app": "Code",
          "idle_seconds": 60,
          "local_hour": 3,
          "expect": {
            "decision": "silence",
            "reasons": ["outside_quiet_hours"]
          }
        },
        {
          "at_ms": 14400000,
          "app": "Code",
          "idle_seconds": 60,
          "local_hour": 7,
          "expect": {
            "decision": "silence",
            "reasons": ["outside_quiet_hours"]
          }
        },
        {
          "at_ms": 18000000,
          "app": "Code",
          "idle_seconds": 60,
          "local_hour": 8,
          "expect": {
            "decision": "interrupt",
            "reasons": ["eligible"]
          }
        }
      ]
    },
    {
      "id": "daily-budget-exhausted",
      "description": "每日额度用尽后必须静默。额度为 1：第一个可打扰的时刻消耗额度，此后即使冷却已过、状态良好，也必须静默而非推迟——静默与推迟的区别正是额度耗尽这一条理由。",
      "policy": {
        "max_idle_seconds": 30,
        "away_idle_seconds": 900,
        "min_focus_ms": 0,
        "max_switches_in_window": 8,
        "switch_window_ms": 600000,
        "quiet_hour_start": 22,
        "quiet_hour_end": 8,
        "daily_budget": 1
      },
      "steps": [
        {
          "at_ms": 0,
          "app": "Code",
          "idle_seconds": 60,
          "local_hour": 9,
          "expect": {
            "decision": "interrupt",
            "reasons": ["eligible"]
          }
        },
        {
          "at_ms": 1500000,
          "app": "Code",
          "idle_seconds": 60,
          "local_hour": 9,
          "expect": {
            "decision": "silence",
            "reasons": ["daily_budget_exhausted"]
          }
        },
        {
          "at_ms": 3000000,
          "app": "Code",
          "idle_seconds": 60,
          "local_hour": 10,
          "expect": {
            "decision": "silence",
            "reasons": ["daily_budget_exhausted"]
          }
        }
      ]
    },
    {
      "id": "cooldown-then-recovery",
      "description": "冷却期内推迟，冷却（20 分钟）过后同一状态应重新变为可打扰。验证冷却确实会过期。",
      "policy": {
        "max_idle_seconds": 30,
        "away_idle_seconds": 900,
        "min_focus_ms": 0,
        "max_switches_in_window": 8,
        "switch_window_ms": 600000,
        "quiet_hour_start": 22,
        "quiet_hour_end": 8,
        "daily_budget": 5
      },
      "steps": [
        {
          "at_ms": 0,
          "app": "Code",
          "idle_seconds": 60,
          "local_hour": 10,
          "expect": {
            "decision": "interrupt",
            "reasons": ["eligible"]
          }
        },
        {
          "at_ms": 300000,
          "app": "Code",
          "idle_seconds": 60,
          "local_hour": 10,
          "expect": {
            "decision": "defer",
