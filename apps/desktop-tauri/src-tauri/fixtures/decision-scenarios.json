    {
      "id": "session-locked-then-unlocked",
      "description": "锁屏期间任何活动都不得打扰；解锁后恢复常规判定。对应 T1.1 的 OpenInputDesktop 读数。",
      "policy": {
        "max_idle_seconds": 30,
        "away_idle_seconds": 900,
        "min_focus_ms": 0,
        "max_switches_in_window": 8,
        "switch_window_ms": 600000,
        "quiet_hour_start": 22,
        "quiet_hour_end": 8,
        "daily_budget": 3
      },
      "steps": [
        {
          "at_ms": 0,
          "app": "Code",
          "idle_seconds": 60,
          "local_hour": 12,
          "session_locked": false,
          "expect": {
            "decision": "interrupt",
            "reasons": ["eligible"]
          }
        },
        {
          "at_ms": 60000,
          "app": "LockApp",
          "idle_seconds": 120,
          "local_hour": 12,
          "session_locked": true,
          "expect": {
            "decision": "silence",
            "reasons": ["idle_too_long"]
          }
        },
        {
          "at_ms": 900000,
          "app": "LockApp",
          "idle_seconds": 900,
          "local_hour": 12,
          "session_locked": true,
          "expect": {
            "decision": "silence",
            "reasons": ["idle_too_long"]
          }
        },
        {
          "at_ms": 1800000,
          "app": "Code",
          "idle_seconds": 45,
          "local_hour": 12,
          "session_locked": false,
          "expect": {
            "decision": "interrupt",
            "reasons": ["eligible"]
          }
        }
