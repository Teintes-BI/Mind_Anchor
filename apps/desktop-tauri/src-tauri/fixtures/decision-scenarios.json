{
  "schema": "comma.desktop.decision-fixtures.v1",
  "description": "Deterministic replay scenarios for the interruption decision engine. Each scenario is a timeline of observations; the replayer expands it into DecisionInput values and asserts the classification at each step. Editing thresholds here does not require touching Rust.",
  "scenarios": [
    {
      "id": "deep-focus-then-pause",
      "description": "用户在同一应用上持续专注，随后停手。专注积累到阈值后应变为可打扰。",
      "policy": {
        "max_idle_seconds": 30,
        "away_idle_seconds": 900,
        "min_focus_ms": 300000,
        "max_switches_in_window": 8,
        "switch_window_ms": 600000,
        "quiet_hour_start": 22,
        "quiet_hour_end": 8,
        "daily_budget": 3
      },
      "steps": [
        {
          "at_ms": 0,
          "app": "Code",
          "idle_seconds": 45,
          "local_hour": 14,
          "expect": {
            "decision": "defer",
            "reasons": ["focus_too_brief"]
          }
        },
        {
          "at_ms": 60000,
          "app": "Code",
          "idle_seconds": 45,
          "local_hour": 14,
          "expect": {
            "decision": "defer",
            "reasons": ["focus_too_brief"]
          }
        },
        {
          "at_ms": 600000,
          "app": "Code",
          "idle_seconds": 60,
          "local_hour": 14,
          "expect": {
            "decision": "interrupt",
            "reasons": ["eligible"]
          }
        }
      ]
    },
    {
      "id": "continuous-typing",
      "description": "用户一直在敲键盘。空闲时长低于活动阈值时绝不打扰，且不应因专注够长而放行。",
      "policy": {
        "max_idle_seconds": 30,
        "away_idle_seconds": 900,
        "min_focus_ms": 300000,
        "max_switches_in_window": 8,
        "switch_window_ms": 600000,
        "quiet_hour_start": 22,
        "quiet_hour_end": 8,
        "daily_budget": 3
      },
      "steps": [
        {
          "at_ms": 0,
          "app": "Code",
          "idle_seconds": 2,
          "local_hour": 10,
          "expect": {
            "decision": "defer",
            "reasons": ["focus_too_brief", "idle_too_short"]
          }
        },
        {
          "at_ms": 900000,
          "app": "Code",
          "idle_seconds": 1,
          "local_hour": 10,
          "expect": {
            "decision": "defer",
            "reasons": ["idle_too_short"]
          }
        }
      ]
    },
    {
      "id": "long-absence",
      "description": "用户离开很久。此刻插入提示没有意义，应推迟而非静默——回来后会重新评估。",
      "policy": {
        "max_idle_seconds": 30,
        "away_idle_seconds": 900,
        "min_focus_ms": 300000,
        "max_switches_in_window": 8,
        "switch_window_ms": 600000,
        "quiet_hour_start": 22,
        "quiet_hour_end": 8,
        "daily_budget": 3
      },
      "steps": [
        {
          "at_ms": 0,
          "app": "Code",
          "idle_seconds": 1800,
          "local_hour": 15,
          "expect": {
            "decision": "defer",
            "reasons": ["focus_too_brief", "idle_too_long"]
          }
        },
        {
          "at_ms": 2100000,
          "app": "Code",
          "idle_seconds": 2400,
          "local_hour": 15,
          "expect": {
            "decision": "defer",
            "reasons": ["idle_too_long"]
          }
        }
      ]
    },
