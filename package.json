{
  "name": "mindanchor",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "clean:appledouble": "node scripts/clean-appledouble.mjs --quiet",
