    "repair:macos:openclaw-registry-notifications": "node scripts/repair-macos-openclaw-registry-notifications.mjs",
    "recover:macos:openclaw-registry-notifications": "node scripts/run-macos-openclaw-registry-notification-recovery-check.mjs",
