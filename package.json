    "release:macos": "corepack pnpm --filter @mindanchor/macos release:candidate",
    "check:macos:signing": "bash scripts/check-macos-signing-prereqs.sh --report-only",
    "test:macos:release": "corepack pnpm --filter @mindanchor/macos release:test",
    "test:macos": "corepack pnpm --filter @mindanchor/macos test",
