    "dev:openclaw-real": "node openclaw/production-runtime-server.mjs",
    "start:openclaw-runtime-lan": "bash scripts/start-openclaw-runtime-lan.sh",
    "stop:openclaw-runtime-lan": "bash scripts/stop-openclaw-runtime-lan.sh",
    "restart:openclaw-runtime-lan": "bash scripts/restart-openclaw-runtime-lan.sh",
    "status:openclaw-runtime-lan": "bash scripts/status-openclaw-runtime-lan.sh",
    "health:openclaw-runtime-lan": "bash scripts/health-openclaw-runtime-lan.sh",
    "install:openclaw-runtime-launchd": "bash scripts/install-openclaw-runtime-launchd.sh",
    "uninstall:openclaw-runtime-launchd": "bash scripts/uninstall-openclaw-runtime-launchd.sh",
    "status:openclaw-runtime-launchd": "bash scripts/status-openclaw-runtime-launchd.sh",
    "start:openclaw-real-lan": "bash scripts/start-openclaw-runtime-lan.sh",
    "stop:openclaw-real-lan": "bash scripts/stop-openclaw-runtime-lan.sh",
    "dev:local-cluster-stack": "bash scripts/dev-local-cluster-stack.sh",
    "prepare:local-cluster-ui-check": "bash scripts/prepare-local-cluster-manual-check.sh",
    "new:cluster-smoke-report": "bash scripts/new-openclaw-cluster-smoke-report.sh",
    "smoke:cluster": "bash scripts/smoke-openclaw-cluster.sh",
    "repro:openclaw:transport-fallback": "node scripts/repro-openclaw-transport-fallback.mjs",
    "repro:openclaw:session-lock-recovery": "node scripts/repro-openclaw-session-lock-recovery.mjs",
    "smoke:web-console": "node scripts/clean-appledouble.mjs --quiet && bash scripts/smoke-web-console.sh && node scripts/clean-appledouble.mjs --quiet",
    "test": "node scripts/clean-appledouble.mjs --quiet && corepack pnpm -r --if-present test && node scripts/clean-appledouble.mjs --quiet"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017"
