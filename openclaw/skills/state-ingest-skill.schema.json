{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindanchor.local/openclaw/skills/state-ingest-skill.schema.json",
  "title": "state-ingest-skill input",
  "type": "object",
  "required": ["events"],
  "properties": {
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["userId", "source", "eventType", "occurredAt"],
        "properties": {
          "userId": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "eventType": {
            "type": "string",
            "minLength": 1
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "clientEventId": {
            "type": "string"
          },
          "payload": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
