{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindanchor.local/openclaw/skills/situation-framing-skill.schema.json",
  "title": "Wayfinder situation framing skill",
  "type": "object",
  "additionalProperties": false,
  "required": ["traceId", "agent", "modelTarget", "summary", "evidenceRefs", "confidence", "riskLevel"],
  "properties": {
    "traceId": { "type": "string", "minLength": 1 },
    "agent": { "const": "situation-framer" },
    "modelTarget": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "uncertainty": { "type": "array", "items": { "type": "string" } },
    "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "riskLevel": { "enum": ["low", "medium", "high", "critical"] }
  }
}
