{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindanchor.local/openclaw/skills/notification-skill.schema.json",
  "title": "notification-skill input",
  "type": "object",
  "required": ["userId", "title", "message", "channel"],
  "properties": {
    "userId": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "channel": {
      "type": "string",
      "enum": ["mobile_push", "desktop_local", "feishu_bot", "telegram_bot"]
    }
  },
  "additionalProperties": true
}
