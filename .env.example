# Legacy compatibility vars for older OpenAI-compatible/chat-completions setups.
MINDANCHOR_OPENAI_BASE_URL=
MINDANCHOR_OPENAI_API_KEY=
MINDANCHOR_OPENAI_MODEL=gpt-5.4
MINDANCHOR_QWEN_BASE_URL=
MINDANCHOR_QWEN_API_KEY=
MINDANCHOR_QWEN_MODEL=qwen-max

# Existing desktop bridge toggles remain optional fallback only.
MINDANCHOR_LAN_PORT=43120
MINDANCHOR_AUDIO_EMOTION_MODE=stub
MINDANCHOR_AUDIO_EMOTION_BASE_URL=
MINDANCHOR_AUDIO_EMOTION_API_KEY=
