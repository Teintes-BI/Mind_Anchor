MINDANCHOR_API_PORT=3001
MINDANCHOR_DATA_FILE=/absolute/path/to/mindanchor/data/mindanchor.json
MINDANCHOR_AGENT_MODE=stub
MINDANCHOR_API_URL=http://localhost:3001
MINDANCHOR_OPENCLAW_BASE_URL=http://localhost:8787
MINDANCHOR_SUPABASE_URL=
MINDANCHOR_SUPABASE_ANON_KEY=
MINDANCHOR_SUPABASE_JWKS_URL=
MINDANCHOR_SUPABASE_JWT_ISSUER=
MINDANCHOR_AUTH_JWT_SECRET=replace-with-a-long-random-secret
MINDANCHOR_AUTH_DEV_BYPASS=true

# Shared default model config: all agents can temporarily point here.
MINDANCHOR_DEFAULT_MODEL_BASE_URL=https://gmncode.cn
MINDANCHOR_DEFAULT_MODEL_API_KEY=replace-with-your-rotated-key
MINDANCHOR_DEFAULT_MODEL_NAME=gpt-5.4
MINDANCHOR_DEFAULT_MODEL_WIRE_API=responses
MINDANCHOR_DEFAULT_MODEL_REASONING_EFFORT=xhigh
MINDANCHOR_DEFAULT_MODEL_DISABLE_RESPONSE_STORAGE=true

# Optional per-agent overrides. Leave commented until you want to swap one agent only.
# MINDANCHOR_AGENT_CHIEF_AGENT_BASE_URL=https://gmncode.cn
# MINDANCHOR_AGENT_CHIEF_AGENT_API_KEY=replace-with-your-rotated-key
# MINDANCHOR_AGENT_CHIEF_AGENT_MODEL=gpt-5.4
# MINDANCHOR_AGENT_CHIEF_AGENT_WIRE_API=responses
